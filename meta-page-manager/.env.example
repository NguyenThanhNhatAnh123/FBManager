# Primary start.bat uses the sibling Chrome Manager host at /pages/.
# Its port comes from Chrome Manager's CM_PORT (default 8000).
# The settings below apply only to optional start-standalone.bat.
# Shared and standalone modes use one Page Manager data lock and cannot run together.
MPM_PORT=8010
MPM_GRAPH_VERSION=v26.0
MPM_OPEN_BROWSER=true
# Optional native Codex executable for manually triggered idea workers.
# Must be an absolute path to one existing .exe; no shell commands or arguments.
# Invalid overrides block the worker instead of silently selecting another CLI.
# Unset: discover the native executable on PATH or in the current user's npm install.
# Example only: replace with the installed native executable on your server.
# PM_CODEX_CLI=D:\Tools\Codex\codex.exe
# Camera QA defaults to the project Python with requirements-producer.txt installed.
# Optional absolute Python executable with NumPy; invalid overrides block camera QA.
# PM_CAMERA_PYTHON=D:\Via\chrome-manager\.venv\Scripts\python.exe
# Optional absolute installed uploader directory; no credentials belong in this file.
# PM_PODSACH_TOOL_ROOT=D:\Tools\podsach-bulk-prep
